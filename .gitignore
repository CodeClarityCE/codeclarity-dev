# Subset lockfiles + workspace yamls generated by the api-dev / frontend-dev
# containers' standalone `pnpm install`. The authoritative lockfile is the
# workspace-level pnpm-lock.yaml at the repo root; container-only pnpm-workspace.yaml
# overrides live under each subdir's .cloud/docker/ instead.
/api/pnpm-lock.yaml
/frontend/pnpm-lock.yaml
/api/pnpm-workspace.yaml
/frontend/pnpm-workspace.yaml
.env
private
setup*.log
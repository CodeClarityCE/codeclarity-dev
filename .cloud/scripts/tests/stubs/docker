#!/bin/sh
# Test stand-in for docker: logs its arguments to STUB_DOCKER_LOG, answers the completeness gate
# with STUB_GATE_REPORT (exit 1 unless it passed), exits STUB_MIGRATE_EXIT (default 0) for the
# migrate job, succeeds for stack commands (volume create, down, up -d), and runs
# "compose ... exec [-T] db" commands here. "buildx imagetools inspect <ref>" prints the digest
# STUB_IMAGE_DIGESTS (a file of "<ref> <digest>" lines) gives the ref, and fails for any other ref.
# Calls into service-package-follower also log NVD_API_KEY from docker's environment to STUB_ENV_LOG.
echo "$*" >>"${STUB_DOCKER_LOG:-/dev/null}"
case " $* " in
" buildx imagetools inspect "*)
	digest=$(awk -v ref="$4" '$1 == ref { print $2 }' "${STUB_IMAGE_DIGESTS:-/dev/null}")
	[ -n "$digest" ] || { echo "ERROR: $4: not found" >&2; exit 1; }
	printf '{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"%s","size":1609}\n' "$digest"
	exit 0
	;;
*" service-package-follower "*)
	echo "NVD_API_KEY=${NVD_API_KEY:-}" >>"${STUB_ENV_LOG:-/dev/null}"
	printf '%s\n' "$STUB_GATE_REPORT"
	case "$STUB_GATE_REPORT" in *'"passed": true'*) exit 0 ;; *) exit 1 ;; esac
	;;
*" run --rm migrate"*) exit "${STUB_MIGRATE_EXIT:-0}" ;;
" volume create "* | *" down "* | *" up -d "*) exit 0 ;;
esac
while [ $# -gt 0 ] && [ "$1" != db ]; do shift; done
[ $# -gt 0 ] || { echo "docker stub: no db command" >&2; exit 1; }
shift
exec "$@"

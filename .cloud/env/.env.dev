PLATFORM_NAME="CodeClarity"
SERVER_NAME=localhost
# SERVER_NAME_EXTRA=", caddy:80"
PORT=3000
HOST=http://${SERVER_NAME}:${PORT}
WEB_HOST=http://${SERVER_NAME}:5173
ENV=dev
COOKIE_SECRET=e8BF4MD6mFKyvwEswEcw3DzchBEvAv3wvhShxAyA

HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443

# Authentication
REQUIRE_ACCOUNT_VERIFICATION=false

# Github oauth
GITHUB_AUTH_CLIENT_ID=!ChangeMe!
GITHUB_AUTH_CLIENT_SECRET=!ChangeMe!
GITHUB_CALLBACK=${HOST}/auth/github/callback
GITHUB_AUTH_CALLBACK=${WEB_HOST}/auth/github/callback

# Gitlab oauth
GITLAB_AUTH_CLIENT_ID=!ChangeMe!
GITLAB_AUTH_CLIENT_SECRET=!ChangeMe!
GITLAB_CALLBACK=${HOST}/auth/gitlab/callback
GITLAB_AUTH_HOST=https://gitlab.com
GITLAB_AUTH_CALLBACK=${WEB_HOST}/auth/gitlab/callback

# AMQP
# TLS-only: RabbitMQ accepts encrypted connections on 5671; plaintext is disabled.
AMQP_ANALYSES_QUEUE=api_request
AMQP_PROTOCOL=amqps
AMQP_HOST=rabbitmq
AMQP_PORT=5671
AMQP_PORT_2=15672
AMQP_PROMETHEUS_PORT=15692
# Encrypted but skip cert verification in dev (self-signed server cert).
AMQP_SSLMODE=require
AMQP_USER=guest
AMQP_PASSWORD=guest

# Email
MAIL_HOST="!ChangeMe!"
MAIL_PORT=465
MAIL_AUTH_USER=noreply@codeclarity.io
MAIL_DEFAULT_FROM=noreply@codeclarity.io
TEST_EMAIL=noreply@codeclarity.io
MAIL_AUTH_PASSWORD="!ChangeMe!"

# PG CONF
POSTGRES_PASSWORD="!ChangeMe!"
# PGDATA defaults to /var/lib/postgresql/18/docker in PostgreSQL 18

# PGBOUNCER CONF
# Pooler (edoburu/pgbouncer) connects to Postgres as PG_DB_USER. Most of its
# config lives inline in the compose `pgbouncer` service; this is the one knob
# referenced there for the client-connection ceiling.
PGBOUNCER_MAX_CLIENT_CONN=500

# Database
# Services/plugins/API connect through the pooler, not directly to Postgres.
PG_DB_USER="postgres"
PG_DB_PASSWORD=${POSTGRES_PASSWORD}
PG_DB_HOST="pgbouncer"
PG_DB_PORT="6432"
PG_DB_NAME="codeclarity"
PG_DB_SSLMODE="disable"

# Connection pool bounds (per service/plugin instance, env-overridable).
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_SECONDS=60
# API (NestJS / pg) pool bound per DataSource.
PG_DB_POOL_MAX=10

# Other
NVD_API_KEY="!ChangeMe!"
VULNERABILITY_LOOKUP_API_KEY='!ChangeMe!'
# NPM_URL="https://replicate.npmjs.com/"
NPM_URL="https://registry.npmjs.org/"
DOWNLOAD_PATH=/private

# ClickUp Integration (OAuth)
CLICKUP_CLIENT_ID='!ChangeMe!'
CLICKUP_CLIENT_SECRET='!ChangeMe!'

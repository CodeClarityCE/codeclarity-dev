CC_BASE_URL=https://localhost/api # devcontainer -> http://172.17.0.1:3000
CC_EMAIL=john.doe@codeclarity.io
CC_PASSWORD=ThisIs4Str0ngP4ssW0rd?
CC_VERIFY_TLS=false

# REQUIRED: GitHub classic PAT with scope `public_repo` (or `repo`).
# Used for (a) creating the CodeClarity GitHub integration so projects are
# imported as git repos instead of FILE-type archive uploads, and (b) lifting
# the historical-commit lookup rate limit from 60/h to 5000/h.
# GH_TOKEN is honoured as an alias for the GitHub API lookups (sample/snapshot
# resolution), but the integration setup reads GITHUB_TOKEN only.
GITHUB_TOKEN=

# OPTIONAL: org / analyzer names provisioned by `_ensure_setup` (defaults:
# js-vuln-study-2026 / js-vuln-study-v2). NB: data/setup.json caches the
# provisioned IDs and wins over these — delete it to re-provision after
# changing the names.
JS_VULN_ORG_NAME=
JS_VULN_ANALYZER_NAME=

# OPTIONAL: poll timeouts, in seconds. POLL_TIMEOUT (default 1200) is the
# stall timeout for *running* work — no per-step progress for this long fails
# the analysis client-side. STARTED_TIMEOUT (default 86400) is the ceiling for
# *queued-only* work that never started; 0 disables it (poll forever).
JS_VULN_POLL_TIMEOUT=
JS_VULN_STARTED_TIMEOUT=

# OPTIONAL: where the downloader's clones land on this host — the DOWNLOAD_PATH
# bind mount that appears as /private inside the containers. Defaults to
# <repo-root>/private, which is correct inside the devcontainer. `poll` deletes
# each checkout once its analysis is terminal and results are persisted; point
# this at a nonexistent path to disable reclamation (one warning, no error) if
# you need to inspect the checkouts of failed analyses by hand.
JS_VULN_CLONE_DIR=

# OPTIONAL: direct-Postgres fallback for provenance capture, used only when
# GET /knowledge/provenance is missing (older API). Defaults:
# 127.0.0.1 / 5432 / postgres / !ChangeMe!. NB: in dev the DB port is
# published on the host only — from inside a container this fallback fails
# (expected; run_meta then records nulls with a warning).
PG_DB_HOST=
PG_DB_PORT=
PG_DB_USER=
PG_DB_PASSWORD=

# NB (not read by the harness): DOWNLOAD_TIMEOUT_SECONDS is a SERVER-side env
# on the downloader container (docker compose). Recommended 900 for snapshot
# runs — deep-history checkouts of big repos exceed the default.
